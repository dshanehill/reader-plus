#!/bin/bash
# Reader+ launcher: builds the app the first time (or after the source changes), then runs it.
HERE="$(cd "$(dirname "$0")" && pwd)"
# Build for Apple Silicon when the Mac has it (the launcher itself may run under Rosetta).
if [ "$(/usr/sbin/sysctl -n hw.optional.arm64 2>/dev/null)" = "1" ]; then ARCH=arm64; else ARCH=x86_64; fi
RES="$HERE/../Resources"
BIN="$HERE/ReaderPlus"
LOG="$HOME/Library/Logs/Reader+.log"
HASH="$ARCH-$(/sbin/md5 -q "$RES/main.swift")"
if [ ! -x "$BIN" ] || [ "$(cat "$RES/.build-hash" 2>/dev/null)" != "$HASH" ]; then
  echo "$(date '+%F %T') building…" >> "$LOG"
  if ! /usr/bin/xcrun swiftc -O -swift-version 5 -target "$ARCH-apple-macos13.0" \
        "$RES/main.swift" -o "$BIN.new" \
        -framework AppKit -framework AVFoundation -framework Carbon -framework ApplicationServices -framework ServiceManagement -framework SwiftUI -framework Vision -framework ScreenCaptureKit >> "$LOG" 2>&1; then
    /usr/bin/say "Reader plus could not start. The build failed." >/dev/null 2>&1 &
    /usr/bin/osascript -e 'display alert "Reader+ could not start" message "The build failed. Details are in Logs › Reader+.log."' >/dev/null 2>&1
    exit 1
  fi
  mv -f "$BIN.new" "$BIN"
  /usr/bin/codesign --force --sign - --identifier local.shane.ReaderPlus "$BIN" >/dev/null 2>&1 || true
  echo "$HASH" > "$RES/.build-hash"
  echo "$(date '+%F %T') build done" >> "$LOG"
fi
exec /usr/bin/arch -$ARCH "$BIN" "$@"
